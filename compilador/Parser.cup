package compilador;

import java_cup.runtime.*;

/* ============================================================
   LangZ - ESPECIFICACAO CUP (Analisador Sintatico)
   Trabalho P2 - Compiladores

   A gramatica e a mesma entregue na A1. O que foi acrescentado
   nesta etapa sao as ACOES SEMANTICAS (classe AnalisadorSemantico)
   e as acoes de GERACAO DE CODIGO (classe GeradorDeCodigo),
   penduradas nas proprias producoes: a traducao e dirigida pela
   sintaxe, sem uma passagem extra sobre a arvore.
   ============================================================ */

parser code {:

    /** Verificacoes semanticas + tabela de simbolos. */
    public AnalisadorSemantico semantico = new AnalisadorSemantico();

    /** Tradutor para o Assembly ficticio da LangZ. */
    public GeradorDeCodigo gerador = new GeradorDeCodigo();

    /** Marca se o fonte tambem apresentou problema de sintaxe. */
    public boolean erroSintatico = false;

    /* Rotulos pendentes dos desvios. Um if ou um while so consegue
       fechar o proprio rotulo depois de reconhecer o corpo, entao o
       rotulo fica guardado aqui ate o momento certo. */
    public java.util.Stack<String> pilhaRotulos = new java.util.Stack<String>();

    /* Instrucoes de incremento do comando for. No texto o incremento
       vem antes do corpo; na execucao ele vem depois. O trecho fica
       guardado ate ser reemitido na posicao correta. */
    public java.util.Stack<java.util.List<String>> pilhaIncremento =
        new java.util.Stack<java.util.List<String>>();

    /** Converte o operando inteiro quando a operacao resulta em real. */
    public String promover(AtributosExpressao operando, String tipoResultado) {
        if ("real".equals(tipoResultado) && "int".equals(operando.tipo)) {
            String destino = gerador.novoRegistrador();
            gerador.emitir("CVTIR", destino + ", " + operando.registrador);
            return destino;
        }
        return operando.registrador;
    }

    /** Tipo comum entre dois operandos, usado nas comparacoes. */
    public String tipoComum(AtributosExpressao a, AtributosExpressao b) {
        return ("real".equals(a.tipo) || "real".equals(b.tipo)) ? "real" : "int";
    }

    /** Gera a instrucao de uma comparacao ja com as conversoes necessarias. */
    public AtributosExpressao comparar(String operador, String mnemonico,
                                       AtributosExpressao a, AtributosExpressao b,
                                       int linha, int coluna) {
        String tipo = semantico.verificarComparacao(operador, a.tipo, b.tipo, linha, coluna);
        String comum = tipoComum(a, b);
        String destino = gerador.novoRegistrador();
        gerador.emitir(mnemonico, destino + ", " + promover(a, comum) + ", " + promover(b, comum));
        return new AtributosExpressao(tipo, destino);
    }

    /** Gera a instrucao de uma operacao aritmetica. */
    public AtributosExpressao calcular(String operador, String mnemonico,
                                       AtributosExpressao a, AtributosExpressao b,
                                       int linha, int coluna) {
        String tipo = semantico.verificarAritmetica(operador, a.tipo, b.tipo, linha, coluna);
        String destino = gerador.novoRegistrador();
        gerador.emitir(mnemonico, destino + ", " + promover(a, tipo) + ", " + promover(b, tipo));
        return new AtributosExpressao(tipo, destino);
    }

    /** Gera a instrucao de uma operacao logica (&& e ||). */
    public AtributosExpressao combinar(String operador, String mnemonico,
                                       AtributosExpressao a, AtributosExpressao b,
                                       int linha, int coluna) {
        String tipo = semantico.verificarLogica(operador, a.tipo, b.tipo, linha, coluna);
        String destino = gerador.novoRegistrador();
        gerador.emitir(mnemonico, destino + ", " + a.registrador + ", " + b.registrador);
        return new AtributosExpressao(tipo, destino);
    }

    /** Acao comum das duas formas de atribuicao (com e sem ponto e virgula). */
    public void atribuir(String nome, AtributosExpressao valor, int linha, int coluna) {
        String tipoDestino = semantico.usar(nome, linha, coluna);
        semantico.verificarAtribuicao(tipoDestino, valor.tipo, nome, linha, coluna);
        String origem = valor.registrador;
        if (semantico.exigeConversao(tipoDestino, valor.tipo)) {
            String convertido = gerador.novoRegistrador();
            gerador.emitir("CVTIR", convertido + ", " + origem);
            origem = convertido;
        }
        gerador.emitir("STORE", semantico.rotuloDe(nome) + ", " + origem);
    }

    public void syntax_error(Symbol s) {
        erroSintatico = true;
        int linha = (s.left >= 0) ? s.left : -1;
        String tok = (s.value != null) ? s.value.toString() : "fim de arquivo";
        if (linha > 0) {
            System.err.println("Erro Sintatico [linha " + linha +
                               ", col " + s.right +
                               "]: token inesperado -> " + tok);
        } else {
            System.err.println("Erro Sintatico [fim do arquivo]: esperava mais tokens");
        }
    }

    public void unrecovered_syntax_error(Symbol s) throws Exception {
        int linha = (s.left >= 0) ? s.left : -1;
        String tok = (s.value != null) ? s.value.toString() : "fim de arquivo";
        if (linha > 0) {
            throw new Exception("Erro fatal [linha " + linha +
                                "]: analise interrompida em -> " + tok);
        } else {
            throw new Exception("Erro fatal [fim do arquivo]: esperava '}' para fechar o bloco");
        }
    }

:};

/* ---------------- TERMINAIS (os mesmos da A1) ---------------- */

terminal IF, ELSE, WHILE, FOR, PRINTF, SCANF;
terminal T_INT, T_REAL, T_CHR, T_STR;
terminal TRUE, FALSE;
terminal PLUS, MINUS, TIMES, DIV, ATTR;
terminal EQ, NEQ, LT, GT, LEQ, GEQ;
terminal AND, OR, NOT;
terminal LPAR, RPAR, LBRACE, RBRACE, SEMI;
terminal String  ID;
terminal Integer NUM_INT;   /* novo na P2: literal inteiro */
terminal Double  NUM_REAL;  /* novo na P2: literal real    */
terminal String  LIT_CHR;
terminal String  LIT_STR;

/* ---------------- NAO TERMINAIS ---------------- */

non terminal programa;
non terminal bloco, lista_cmd, cmd;
non terminal decl, atrib, atrib_inc;
non terminal String tipo;
non terminal se_senao, opt_senao, enquanto, para, escrever, ler;

/* expr e termo devolvem o tipo (semantica) e o registrador (codigo) */
non terminal AtributosExpressao expr, termo;

precedence left OR;
precedence left AND;
precedence left EQ, NEQ;
precedence left LT, GT, LEQ, GEQ;
precedence left PLUS, MINUS;
precedence left TIMES, DIV;
precedence right NOT;
precedence left ELSE;

start with programa;

/* ============================================================
   PROGRAMA E BLOCOS
   O primeiro bloco aberto e o escopo GLOBAL; cada bloco interno
   empilha um escopo LOCAL, descartado ao encontrar o '}'.
   ============================================================ */

programa ::= bloco {: gerador.emitir("HALT"); :};

bloco    ::= LBRACE {: semantico.abrirEscopo(); :} lista_cmd RBRACE {: semantico.fecharEscopo(); :}
           | LBRACE {: semantico.abrirEscopo(); :} RBRACE           {: semantico.fecharEscopo(); :};

lista_cmd ::= cmd lista_cmd
            | cmd;

cmd       ::= decl
            | atrib
            | se_senao
            | enquanto
            | para
            | escrever
            | ler
            | bloco;

/* ============================================================
   DECLARACAO -> registra o identificador na tabela de simbolos
   ============================================================ */

decl ::= tipo:t ID:i SEMI
         {: semantico.declarar(i, t, ileft, iright); :};

tipo ::= T_INT  {: RESULT = "int";  :}
       | T_REAL {: RESULT = "real"; :}
       | T_CHR  {: RESULT = "chr";  :}
       | T_STR  {: RESULT = "str";  :};

/* ============================================================
   ATRIBUICAO -> checa declaracao e tipos, gera STORE
   ============================================================ */

atrib     ::= ID:i ATTR expr:e SEMI {: atribuir(i, e, ileft, iright); :};

atrib_inc ::= ID:i ATTR expr:e      {: atribuir(i, e, ileft, iright); :};

/* ============================================================
   COMANDO if / else
      JMPF Rc, L0 ... JMP L1 ... L0: ... L1:
   ============================================================ */

se_senao ::= IF {: gerador.emitirComentario("comando if: avaliacao da condicao"); :}
             LPAR expr:c RPAR
             {:
                 semantico.verificarCondicao(c.tipo, "if", cleft, cright);
                 String rotuloFalso = gerador.novoRotulo();
                 gerador.emitir("JMPF", c.registrador + ", " + rotuloFalso);
                 pilhaRotulos.push(rotuloFalso);
             :}
             bloco opt_senao
             {: gerador.emitirRotulo(pilhaRotulos.pop()); :};

opt_senao ::= ELSE
              {:
                  String rotuloFalso = pilhaRotulos.pop();
                  String rotuloFim = gerador.novoRotulo();
                  gerador.emitir("JMP", rotuloFim);   // encerra o caminho verdadeiro
                  gerador.emitirRotulo(rotuloFalso);  // inicia o caminho falso
                  pilhaRotulos.push(rotuloFim);
              :}
              bloco
            | ;

/* ============================================================
   COMANDO while
      L0: ... JMPF Rc, L1 ... JMP L0 ... L1:
   ============================================================ */

enquanto ::= WHILE
             {:
                 gerador.emitirComentario("comando while: inicio do laco");
                 String rotuloInicio = gerador.novoRotulo();
                 gerador.emitirRotulo(rotuloInicio);
                 pilhaRotulos.push(rotuloInicio);
             :}
             LPAR expr:c RPAR
             {:
                 semantico.verificarCondicao(c.tipo, "while", cleft, cright);
                 String rotuloFim = gerador.novoRotulo();
                 gerador.emitir("JMPF", c.registrador + ", " + rotuloFim);
                 pilhaRotulos.push(rotuloFim);
             :}
             bloco
             {:
                 String rotuloFim = pilhaRotulos.pop();
                 String rotuloInicio = pilhaRotulos.pop();
                 gerador.emitir("JMP", rotuloInicio);
                 gerador.emitirRotulo(rotuloFim);
             :};

/* ============================================================
   COMANDO for
      inicializacao; L0: condicao; JMPF -> L1; corpo; incremento;
      JMP L0; L1:
   O incremento e capturado em um buffer para ser reemitido depois
   do corpo do laco.
   ============================================================ */

para ::= FOR {: gerador.emitirComentario("comando for: inicializacao"); :}
         LPAR atrib
         {:
             gerador.emitirComentario("comando for: teste da condicao");
             String rotuloTeste = gerador.novoRotulo();
             gerador.emitirRotulo(rotuloTeste);
             pilhaRotulos.push(rotuloTeste);
         :}
         expr:c SEMI
         {:
             semantico.verificarCondicao(c.tipo, "for", cleft, cright);
             String rotuloFim = gerador.novoRotulo();
             gerador.emitir("JMPF", c.registrador + ", " + rotuloFim);
             pilhaRotulos.push(rotuloFim);
             gerador.iniciarCaptura();   // o incremento vai para o buffer
         :}
         atrib_inc
         {: pilhaIncremento.push(gerador.encerrarCaptura()); :}
         RPAR bloco
         {:
             gerador.emitirComentario("comando for: incremento");
             gerador.emitirTrecho(pilhaIncremento.pop()); // incremento apos o corpo
             String rotuloFim = pilhaRotulos.pop();
             String rotuloTeste = pilhaRotulos.pop();
             gerador.emitir("JMP", rotuloTeste);
             gerador.emitirRotulo(rotuloFim);
         :};

/* ============================================================
   ENTRADA E SAIDA: printf / scanf
   ============================================================ */

escrever ::= PRINTF LPAR expr:e RPAR SEMI
             {: gerador.emitir("WRITE", e.registrador); :};

ler      ::= SCANF LPAR ID:i RPAR SEMI
             {:
                 semantico.usar(i, ileft, iright);
                 gerador.emitir("READ", semantico.rotuloDe(i));
             :};

/* ============================================================
   EXPRESSOES: verificam operandos e ja emitem a instrucao
   ============================================================ */

expr ::= expr:a PLUS  expr:b {: RESULT = calcular("+", "ADD", a, b, aleft, aright); :}
       | expr:a MINUS expr:b {: RESULT = calcular("-", "SUB", a, b, aleft, aright); :}
       | expr:a TIMES expr:b {: RESULT = calcular("*", "MUL", a, b, aleft, aright); :}
       | expr:a DIV   expr:b {: RESULT = calcular("/", "DIV", a, b, aleft, aright); :}
       | expr:a EQ    expr:b {: RESULT = comparar("==", "CMPEQ", a, b, aleft, aright); :}
       | expr:a NEQ   expr:b {: RESULT = comparar("!=", "CMPNE", a, b, aleft, aright); :}
       | expr:a LT    expr:b {: RESULT = comparar("<",  "CMPLT", a, b, aleft, aright); :}
       | expr:a GT    expr:b {: RESULT = comparar(">",  "CMPGT", a, b, aleft, aright); :}
       | expr:a LEQ   expr:b {: RESULT = comparar("<=", "CMPLE", a, b, aleft, aright); :}
       | expr:a GEQ   expr:b {: RESULT = comparar(">=", "CMPGE", a, b, aleft, aright); :}
       | expr:a AND   expr:b {: RESULT = combinar("&&", "AND", a, b, aleft, aright); :}
       | expr:a OR    expr:b {: RESULT = combinar("||", "OR",  a, b, aleft, aright); :}
       | MINUS expr:a
         {:
             String t = semantico.verificarNegativo(a.tipo, aleft, aright);
             String destino = gerador.novoRegistrador();
             gerador.emitir("NEG", destino + ", " + a.registrador);
             RESULT = new AtributosExpressao(t, destino);
         :}
         %prec NOT
       | NOT expr:a
         {:
             String t = semantico.verificarNegacao(a.tipo, aleft, aright);
             String destino = gerador.novoRegistrador();
             gerador.emitir("NOT", destino + ", " + a.registrador);
             RESULT = new AtributosExpressao(t, destino);
         :}
       | termo:t {: RESULT = t; :};

termo ::= ID:i
          {:
              String t = semantico.usar(i, ileft, iright);
              String destino = gerador.novoRegistrador();
              gerador.emitir("LOAD", destino + ", " + semantico.rotuloDe(i));
              RESULT = new AtributosExpressao(t, destino);
          :}
        | NUM_INT:v
          {:
              String destino = gerador.novoRegistrador();
              gerador.emitir("LOADI", destino + ", " + v);
              RESULT = new AtributosExpressao("int", destino);
          :}
        | NUM_REAL:v
          {:
              String destino = gerador.novoRegistrador();
              gerador.emitir("LOADI", destino + ", " + v);
              RESULT = new AtributosExpressao("real", destino);
          :}
        | LIT_CHR:v
          {:
              String destino = gerador.novoRegistrador();
              gerador.emitir("LOADI", destino + ", " + v);
              RESULT = new AtributosExpressao("chr", destino);
          :}
        | LIT_STR:v
          {:
              String destino = gerador.novoRegistrador();
              gerador.emitir("LOADI", destino + ", " + v);
              RESULT = new AtributosExpressao("str", destino);
          :}
        | TRUE
          {:
              String destino = gerador.novoRegistrador();
              gerador.emitir("LOADI", destino + ", 1");
              RESULT = new AtributosExpressao(AnalisadorSemantico.LOGICO, destino);
          :}
        | FALSE
          {:
              String destino = gerador.novoRegistrador();
              gerador.emitir("LOADI", destino + ", 0");
              RESULT = new AtributosExpressao(AnalisadorSemantico.LOGICO, destino);
          :}
        | LPAR expr:e RPAR {: RESULT = e; :};
